<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.omni.paper.plist — forward-test the sequential ICT engine in PAPER mode.
  Runs one evaluation tick every 60s via paper_runner.py --once.
  SAFE: never writes omni_cmd.txt, never places a real order. Pure simulation.

  Load:   launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.omni.paper.plist
  Unload: launchctl bootout   gui/$(id -u)/com.omni.paper
  Status: cd python && ../.venv/bin/python paper_runner.py --status
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.omni.paper</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/yuhfriendchris/Omni-full-ALGO-Trading-Bot/.venv/bin/python</string>
    <string>/Users/yuhfriendchris/Omni-full-ALGO-Trading-Bot/python/paper_runner.py</string>
    <string>--once</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/yuhfriendchris/Omni-full-ALGO-Trading-Bot/python</string>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/yuhfriendchris/Omni-full-ALGO-Trading-Bot/logs/paper_runner.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yuhfriendchris/Omni-full-ALGO-Trading-Bot/logs/paper_runner.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
</dict>
</plist>
