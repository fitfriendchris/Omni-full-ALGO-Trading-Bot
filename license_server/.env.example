# ── License Server Environment ──────────────────────────────
# Copy to .env on your server and fill in real values.

# A secret token for the admin API — choose something long and random
ADMIN_TOKEN=change-this-to-a-long-random-secret

# Stripe keys (from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: port override (Railway sets $PORT automatically)
PORT=5000

# Optional: SendGrid for automatic license key emails
# SENDGRID_API_KEY=SG...
# FROM_EMAIL=noreply@omni-ict.com
